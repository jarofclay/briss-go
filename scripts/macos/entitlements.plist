<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime exception for Briss. The PDF engine (PDFium as WebAssembly
     under wazero) compiles to machine code at run time: it maps memory, writes
     the code and then makes it executable, without MAP_JIT. The hardened runtime,
     which notarization requires, blocks that unless this entitlement is set. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
